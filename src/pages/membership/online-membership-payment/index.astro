---
import MainLayout from "../../../layouts/MainLayout.astro";

---

<MainLayout title="Online Dues Payment">
  <div class="reg-wrap">
    <p class="intro">
      ACMS members who wish to pay dues for the current year, past years, or future years may
      complete the form below. After submitting you will be directed to Stripe
      to complete payment. Members wishing to pay by check instead may skip the
      Payment below and mail payment to the ACMS Executive Secretary.
    </p>

    <script async src="https://js.stripe.com/v3/buy-button.js"></script>

    <stripe-buy-button
      buy-button-id="buy_btn_1Tj0ZH2dNruWKJZeoFYUKT0C"
      publishable-key="pk_live_51TifaM2dNruWKJZet2qLTWGOA8mAhuGVEhrdfALBJ0iM8psgTJ4aKtUO9svMfwy9qDpwkR4awJQ1URt2maIUS4Sn00sv9NtiDz"
    ></stripe-buy-button>

    <stripe-buy-button
      buy-button-id="buy_btn_1Tj0vs2dNruWKJZeqLbcoLzw"
      publishable-key="pk_live_51TifaM2dNruWKJZet2qLTWGOA8mAhuGVEhrdfALBJ0iM8psgTJ4aKtUO9svMfwy9qDpwkR4awJQ1URt2maIUS4Sn00sv9NtiDz"
    ></stripe-buy-button>

    <stripe-buy-button
      buy-button-id="buy_btn_1Tj12g2dNruWKJZeR1IU1Lsf"
      publishable-key="pk_live_51TifaM2dNruWKJZet2qLTWGOA8mAhuGVEhrdfALBJ0iM8psgTJ4aKtUO9svMfwy9qDpwkR4awJQ1URt2maIUS4Sn00sv9NtiDz"
    ></stripe-buy-button>

    <stripe-buy-button
      buy-button-id="buy_btn_1Tj1522dNruWKJZePJzRCvjK"
      publishable-key="pk_live_51TifaM2dNruWKJZet2qLTWGOA8mAhuGVEhrdfALBJ0iM8psgTJ4aKtUO9svMfwy9qDpwkR4awJQ1URt2maIUS4Sn00sv9NtiDz"
    ></stripe-buy-button>
    <stripe-buy-button
      buy-button-id="buy_btn_1Tj17l2dNruWKJZeQokTtPpu"
      publishable-key="pk_live_51TifaM2dNruWKJZet2qLTWGOA8mAhuGVEhrdfALBJ0iM8psgTJ4aKtUO9svMfwy9qDpwkR4awJQ1URt2maIUS4Sn00sv9NtiDz"
    ></stripe-buy-button>

  </div>
</MainLayout>

<script>
  const form        = document.getElementById("reg-form")        as HTMLFormElement;
  const countryEl   = document.getElementById("country")         as HTMLSelectElement;
  const stateField  = document.getElementById("state-field")     as HTMLDivElement;

  countryEl.addEventListener("change", () => {
    stateField.style.display = countryEl.value === "US" ? "" : "none";
  });

const errorDiv    = document.getElementById("form-error")    as HTMLDivElement;
  const paymentStep = document.getElementById("payment-step")  as HTMLDivElement;
  const paypalLink  = document.getElementById("paypal-link")   as HTMLAnchorElement;
  const yearsEl     = document.getElementById("years")         as HTMLSelectElement;
  const totalDisplay = document.getElementById("total-display") as HTMLParagraphElement;

  const unitPrice: Record<string, number> = { Regular: 30, Student: 10, Retired: 10 };

  function updateTotal() {
    const cat = (form.querySelector<HTMLInputElement>(
      'input[name="membership_category"]:checked'
    ))?.value;
    const years = parseInt(yearsEl.value);
    if (cat && years) {
      const total = unitPrice[cat] * years;
      totalDisplay.textContent = `Total: $${total}`;
    } else {
      totalDisplay.textContent = "";
    }
  }

  form.querySelectorAll('input[name="membership_category"]').forEach(r =>
    r.addEventListener("change", updateTotal)
  );
  yearsEl.addEventListener("change", updateTotal);

  // Math captcha
  const pool = [
    { q: "2³",          a: 8   },
    { q: "3²",          a: 9   },
    { q: "2⁵",          a: 32  },
    { q: "4²",          a: 16  },
    { q: "√9",          a: 3   },
    { q: "√25",         a: 5   },
    { q: "√49",         a: 7   },
    { q: "√64",         a: 8   },
    { q: "sin(90°)",    a: 1   },
    { q: "cos(0°)",     a: 1   },
    { q: "sin(0°)",     a: 0   },
    { q: "cos(180°)",   a: -1  },
    { q: "3!",          a: 6   },
    { q: "4!",          a: 24  },
    { q: "0!",          a: 1   },
    { q: "log₂(8)",     a: 3   },
    { q: "log₂(16)",    a: 4   },
    { q: "log₁₀(1000)", a: 3   },
    { q: "|−7|",        a: 7   },
    { q: "|−15|",       a: 15  },
    { q: "⌊π⌋",         a: 3   },
    { q: "⌈e⌉",         a: 3   },
    { q: "13 mod 5",    a: 3   },
    { q: "17 mod 4",    a: 1   },
    { q: "⌊√10⌋",       a: 3   },
  ];
  const pick = pool[Math.floor(Math.random() * pool.length)];
  const captchaAnswer = pick.a;
  (document.getElementById("captcha-label") as HTMLLabelElement).textContent =
    `What is ${pick.q}? *`;

  form.addEventListener("submit", (e) => {
    e.preventDefault();

    if ((document.getElementById("hp") as HTMLInputElement).value) return;

    errorDiv.hidden = true;

    // Captcha check
    const given = parseInt((document.getElementById("captcha-answer") as HTMLInputElement).value);
    if (given !== captchaAnswer) {
      errorDiv.textContent = "Incorrect answer to the verification question. Please try again.";
      errorDiv.hidden = false;
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const cat = form.querySelector<HTMLInputElement>(
      'input[name="membership_category"]:checked'
    );
    if (!cat) {
      errorDiv.textContent = "Please select a membership category.";
      errorDiv.hidden = false;
      return;
    }

    const years = parseInt(yearsEl.value);
    const amount = (unitPrice[cat.value] * years).toFixed(2);
    const itemName = years === 1
      ? `ACMS Dues – ${cat.value}`
      : `ACMS Dues – ${cat.value} (${years} years)`;

    const params = new URLSearchParams({
      cmd: "_xclick",
      business: "treasurer@acmsonline.org",
      item_name: itemName,
      amount,
      currency_code: "USD",
      return: window.location.origin + "/membership/thank-you/",
    });

    paypalLink.href = `https://www.paypal.com/cgi-bin/webscr?${params.toString()}`;
    form.hidden = true;
    paymentStep.hidden = false;
  });
</script>

<style>
  .reg-wrap {
    max-width: 580px;
  }

  .intro {
    margin-bottom: 1.5rem;
  }

  .honeypot-wrap {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .field {
    margin-bottom: 1.1rem;
  }

  .field label,
  .field legend {
    display: block;
    font-weight: bold;
    margin-bottom: 0.3rem;
    font-size: 0.95rem;
  }

  .req { color: #c00; }

  input[type="text"],
  input[type="email"],
  select {
    width: 100%;
    padding: 0.45rem 0.6rem;
    border: 1px solid #9ca3af;
    border-radius: 3px;
    font-family: inherit;
    font-size: 1rem;
    box-sizing: border-box;
    background: #fff;
  }

  input[type="text"]:focus,
  input[type="email"]:focus,
  select:focus {
    outline: 2px solid steelblue;
    outline-offset: 1px;
    border-color: steelblue;
  }

  .field-row {
    display: flex;
    gap: 1rem;
  }

  .field-row .field { flex: 1; }

  .field-row--city .field--city  { flex: 2; }
  .field-row--city .field--state { flex: 2; }
  .field-row--city .field--zip   { flex: 1; }

  .field--category {
    border: none;
    padding: 0;
    margin: 0 0 1.1rem;
  }

  .radio-label {
    display: block;
    font-weight: normal;
    margin: 0.3rem 0;
    cursor: pointer;
  }

  .radio-label input { margin-right: 0.4rem; }

  .field--years select { max-width: 280px; }

  .total-display {
    margin: 0.4rem 0 0;
    font-weight: bold;
    color: #1e40af;
  }

  .field--captcha input {
    max-width: 120px;
  }

  .msg {
    padding: 0.75rem 1rem;
    border-radius: 3px;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .msg--error {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    color: #b91c1c;
  }

  .btn-submit {
    background: steelblue;
    color: #fff;
    border: none;
    padding: 0.65rem 1.4rem;
    font-size: 1rem;
    font-family: inherit;
    border-radius: 3px;
    cursor: pointer;
  }

  .btn-submit:hover { background: #2563a8; }

  .payment-step {
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-radius: 4px;
    padding: 1.5rem;
    max-width: 520px;
  }

  .payment-step h2 { margin-top: 0; color: #166534; }

  .btn-paypal {
    display: inline-block;
    background: #0070ba;
    color: #fff;
    text-decoration: none;
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    font-family: inherit;
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .btn-paypal:hover { background: #005ea6; color: #fff; }

  .skip-note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #374151;
  }

  @media (max-width: 560px) {
    .field-row { flex-direction: column; gap: 0; }
  }
</style>
