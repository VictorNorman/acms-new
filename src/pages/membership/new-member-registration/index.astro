---
import MainLayout from "../../../layouts/MainLayout.astro";

const PAYPAL_BUSINESS = "treasurer@acmsonline.org";
const RETURN_URL = "/membership/new-member-registration/thank-you/";

const paypalBase = "https://www.paypal.com/cgi-bin/webscr";
function paypalLink(category: string, amount: string) {
  const p = new URLSearchParams({
    cmd: "_xclick",
    business: PAYPAL_BUSINESS,
    item_name: `ACMS Membership – ${category}`,
    amount,
    currency_code: "USD",
    return: RETURN_URL,
  });
  return `${paypalBase}?${p.toString()}`;
}

const paypalLinks = {
  Regular: paypalLink("Regular", "30.00"),
  Student: paypalLink("Student", "10.00"),
  Retired: paypalLink("Retired", "10.00"),
};
