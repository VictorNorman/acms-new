<script>
  import emailjs from "@emailjs/browser";

  // ── EmailJS config ──────────────────────────────────────────────────────────
  // Replace these with your actual EmailJS service ID, template ID, and public key.
  // Template variables used: first_name, last_name, email, institution,
  //   address, city, state, zip, country, membership_category, membership_amount
  const EMAILJS_SERVICE_ID  = "YOUR_EMAILJS_SERVICE_ID";
  const EMAILJS_TEMPLATE_ID = "YOUR_EMAILJS_TEMPLATE_ID";
  const EMAILJS_PUBLIC_KEY  = "YOUR_EMAILJS_PUBLIC_KEY";

  // ── PayPal links (built at build-time in frontmatter) ──────────────────────
  const paypalLinks: Record<string, string> = {
    Regular: document.documentElement.dataset.paypalRegular ?? "#",
    Student: document.documentElement.dataset.paypalStudent ?? "#",
    Retired: document.documentElement.dataset.paypalRetired ?? "#",
  };

  emailjs.init(EMAILJS_PUBLIC_KEY);

  const form        = document.getElementById("reg-form")        as HTMLFormElement;
  const submitBtn   = document.getElementById("submit-btn")      as HTMLButtonElement;
  const errorDiv    = document.getElementById("form-error")      as HTMLDivElement;
  const paymentStep = document.getElementById("payment-step")    as HTMLDivElement;
  const paypalLink  = document.getElementById("paypal-link")     as HTMLAnchorElement;
  const countryEl   = document.getElementById("country")         as HTMLSelectElement;
  const stateField  = document.getElementById("state-field")     as HTMLDivElement;

  // Show/hide state dropdown based on country
  countryEl.addEventListener("change", () => {
    stateField.style.display = countryEl.value === "US" ? "" : "none";
  });

  // Math captcha
  const pool = [
    { q: "2³",          a: 8   },
    { q: "3²",          a: 9   },
    { q: "2⁵",          a: 32  },
    { q: "4²",          a: 16  },
    { q: "√9",          a: 3   },
    { q: "√25",         a: 5   },
    { q: "√49",         a: 7   },
    { q: "√64",         a: 8   },
    { q: "sin(90°)",    a: 1   },
    { q: "cos(0°)",     a: 1   },
    { q: "sin(0°)",     a: 0   },
    { q: "cos(180°)",   a: -1  },
    { q: "3!",          a: 6   },
    { q: "4!",          a: 24  },
    { q: "0!",          a: 1   },
    { q: "log₂(8)",     a: 3   },
    { q: "log₂(16)",    a: 4   },
    { q: "log₁₀(1000)", a: 3   },
    { q: "|−7|",        a: 7   },
    { q: "|−15|",       a: 15  },
    { q: "⌊π⌋",         a: 3   },
    { q: "⌈e⌉",         a: 3   },
    { q: "13 mod 5",    a: 3   },
    { q: "17 mod 4",    a: 1   },
    { q: "⌊√10⌋",       a: 3   },
  ];
  const pick = pool[Math.floor(Math.random() * pool.length)];
  const captchaAnswer = pick.a;
  (document.getElementById("captcha-label") as HTMLLabelElement).textContent =
    `What is ${pick.q}? *`;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Honeypot check
    const hp = (document.getElementById("hp") as HTMLInputElement).value;
    if (hp) return;

    errorDiv.hidden = true;

    // Captcha check
    const given = parseInt((document.getElementById("captcha-answer") as HTMLInputElement).value);
    if (given !== captchaAnswer) {
      errorDiv.textContent = "Incorrect answer to the verification question. Please try again.";
      errorDiv.hidden = false;
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const categoryInput = form.querySelector<HTMLInputElement>(
      'input[name="membership_category"]:checked'
    );
    if (!categoryInput) {
      showError("Please select a membership category.");
      return;
    }

    const amounts: Record<string, string> = { Regular: "$30", Student: "$10", Retired: "$10" };

    submitBtn.disabled = true;
    submitBtn.textContent = "Submitting…";

    const templateParams = {
      first_name:         (form.elements.namedItem("first_name") as HTMLInputElement).value,
      last_name:          (form.elements.namedItem("last_name")  as HTMLInputElement).value,
      email:              (form.elements.namedItem("email")      as HTMLInputElement).value,
      institution:        (form.elements.namedItem("institution") as HTMLInputElement).value,
      address:            (form.elements.namedItem("address")    as HTMLInputElement).value,
      city:               (form.elements.namedItem("city")       as HTMLInputElement).value,
      state:              (form.elements.namedItem("state")      as HTMLSelectElement).value,
      zip:                (form.elements.namedItem("zip")        as HTMLInputElement).value,
      country:            countryEl.options[countryEl.selectedIndex].text,
      membership_category: categoryInput.value,
      membership_amount:  amounts[categoryInput.value] ?? "",
    };

    try {
      await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, templateParams);
      form.hidden = true;
      paypalLink.href = paypalLinks[categoryInput.value] ?? "#";
      paymentStep.hidden = false;
    } catch {
      showError(
        "There was a problem submitting your registration. Please try again, " +
        "or contact us directly if the problem persists."
      );
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit Registration";
    }
  });

  function showError(msg: string) {
    errorDiv.textContent = msg;
    errorDiv.hidden = false;
  }
</script>

<!-- Embed the build-time PayPal URLs so the client script can read them -->
<script
  is:inline
  define:vars={{
    paypalRegular: paypalLinks.Regular,
    paypalStudent: paypalLinks.Student,
    paypalRetired: paypalLinks.Retired,
  }}
>
  document.documentElement.dataset.paypalRegular = paypalRegular;
  document.documentElement.dataset.paypalStudent = paypalStudent;
  document.documentElement.dataset.paypalRetired = paypalRetired;
</script>

